# Docker Environment Variables
# Copy this to .env.local for local Docker development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/simple_suppers_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/simple_suppers_test

# Supabase (use local Supabase or mock)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_key_here
SUPABASE_SECRET_KEY=your_local_secret_here

# NextAuth
NEXTAUTH_SECRET=docker-test-secret-min-32-characters-long-for-security
NEXTAUTH_URL=http://localhost:3010

# Unsplash (optional for tests)
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=test_key

# Node Environment
NODE_ENV=development
