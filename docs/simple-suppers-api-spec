    "user_has_purchased": false
  }
}
```

**Success Response (200) - Full Access (Purchased/Free plans):**
```json
{
  "success": true,
  "data": {
    "plan": {
      "id": "uuid",
      "title": "string",
      "description": "string",
      "duration_days": "number",
      "final_price": "number",
      "provider": {
        "name": "string",
        "bio": "string"
      },
      "days": [
        {
          "day_number": "number",
          "day_title": "string",
          "meals": [
            {
              "meal_type": "breakfast" | "lunch" | "dinner" | "snack",
              "meal_name": "string",
              "description": "string",
              "prep_time_minutes": "number",
              "cook_time_minutes": "number",
              "servings": "number",
              "ingredients": ["string"],
              "instructions": "string",
